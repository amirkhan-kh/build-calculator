# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=calculator_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=calculator_db

# ─── Backend DB URLs ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://calculator_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/calculator_db
ASYNC_DATABASE_URL=postgresql+asyncpg://calculator_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/calculator_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Генерировать: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_64

# ─── CORS (список через запятую) ─────────────────────────────────────────────
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ─── Next.js (бейкится в образ при сборке — используется браузером) ──────────
NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# ─── Cookies — false для HTTP, true только при HTTPS ─────────────────────────
SECURE_COOKIES=true

# ─── MinIO S3 ─────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=https://yourdomain.com/media
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_USER
MINIO_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD_MIN_8_CHARS
MINIO_BUCKET=calculator-media

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ─── Monitoring ───────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
